{
  "name": "it-asset-management-backend",
  "version": "1.0.0",
  "description": "NestJS backend for IT Asset Management System",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/typeorm": "latest",
    "bcryptjs": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "multer": "latest",
    "passport": "latest",
    "passport-jwt": "latest",
    "pg": "^8.21.0",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "typeorm": "latest",
    "xlsx": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/schematics": "latest",
    "@nestjs/testing": "latest",
    "@types/bcryptjs": "latest",
    "@types/express": "latest",
    "@types/multer": "latest",
    "@types/node": "latest",
    "@types/passport-jwt": "latest",
    "prettier": "latest",
